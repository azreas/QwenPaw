# QwenPaw 企业化测试环境变量样例
# 复制为 enterprise-test.env 并填入真实值，不要提交到代码仓库

# 工作目录
QWENPAW_WORKING_DIR=/app/working
QWENPAW_SECRET_DIR=/app/working.secret
QWENPAW_BACKUP_DIR=/app/working.backups

# 存储后端配置
# 可选: json (默认), postgres, sqlite
QWENPAW_STORAGE_BACKEND=postgres

# PostgreSQL 连接（storage_backend=postgres 时必填）
QWENPAW_DATABASE_URL=postgresql+asyncpg://qwenpaw:change-me@postgres:5432/qwenpaw

# Redis 连接（配额启用时必填）
QWENPAW_REDIS_URL=redis://redis:6379/0

# Console 身份认证
QWENPAW_AUTH_ENABLED=true
QWENPAW_AUTH_USERNAME=admin
QWENPAW_AUTH_PASSWORD=change-me

# WebChat 安全配置
# 生产环境必须设置为 32 字节以上的随机字符串
QWENPAW_WEBCHAT_SESSION_SECRET=replace-with-32-byte-secret

# SSO 登录配置（SSO 联调时必填）
QWENPAW_WEBCHAT_SSO_LOGIN_URL=https://sso.example.com/login

# 企微扫码登录配置（企微联调时必填）
QWENPAW_WEBCHAT_QRCODE_LOGIN_URL=https://qyapi.example.com/login

# CORS 白名单（多域名用逗号分隔）
QWENPAW_CORS_ORIGINS=https://ai.example.com

# 日志格式：json 或 text
QWENPAW_LOG_FORMAT=json

# 配额限流（启用后需要 Redis）
QWENPAW_QUOTA_ENABLED=true

# 可选配置
# QWENPAW_DB_POOL_SIZE=20
# QWENPAW_DB_ECHO=false
